# API Configuration
API_PORT=3001
NODE_ENV=development

# Authentication
FX_AUTH_SECRET=fx-enterprise-default-development-secret-key-32chars!

# Gemini AI
GEMINI_API_KEY=sk-placeholder-key-for-development

# App URL
APP_URL=http://localhost:3000

# Development Database (optional - if using PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/fx_dev

# Users Configuration (JSON format)
FX_AUTH_USERS_JSON=[]

# Vite Dev Server
VITE_API_URL=http://localhost:3001
